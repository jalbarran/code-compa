{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "outDir": "out",
    "lib": ["ES2022"],
    "sourceMap": true,
    "strict": true,
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@bufbuild/protobuf": ["node_modules/@bufbuild/protobuf"],
      "@bufbuild/protobuf/*": ["node_modules/@bufbuild/protobuf/*"],
      "@connectrpc/*": ["node_modules/@connectrpc/*"]
    }
  },
  "include": ["src/**/*"]
}
