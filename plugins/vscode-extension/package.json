{
  "name": "code-compa-vscode",
  "displayName": "Code Compa",
  "description": "Decentralized remote control and monitoring for AI agents",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "code-compa.triggerMockIntervention",
        "title": "Code Compa: Trigger Mock Intervention"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code-compa-sidebar",
          "title": "Code Compa",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "code-compa-sidebar": [
        {
          "type": "webview",
          "id": "code-compa.sidebarView",
          "name": "Pair Mobile Companion"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.8.0",
    "@connectrpc/connect": "^1.4.0",
    "@connectrpc/connect-node": "^1.4.0",
    "code-compa-proto-ts": "file:../../packages/proto-ts",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/qrcode": "^1.5.6",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.1.3"
  }
}
